/* main window */
QMainWindow {
    background-color: #1e1e1e;
    color: #ffffff;
}

/* status frame */
QFrame#statusFrame {
    background-color: #2d2d30;
    border: 1px solid #3e3e42;
    border-radius: 8px;
    padding: 10px;
}

/* status labels */
QLabel#batteryLabel {
    color: #2E7D32;
    background-color: #1b3624;
    padding: 8px;
    border-radius: 4px;
    border: 1px solid #2d5a3b;
    font-weight: bold;
    font-size: 12pt;
}

QLabel#connectionLabel {
    color: #1565C0;
    background-color: #1b2b3a;
    padding: 8px;
    border-radius: 4px;
    border: 1px solid #2d4a6b;
    font-weight: bold;
    font-size: 12pt;
}

/* group boxes */
QGroupBox {
    font-weight: bold;
    border: 2px solid #3e3e42;
    border-radius: 6px;
    padding: 10px;
    margin-top: 1ex;
    background-color: #2d2d30;
    color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px 0 3px;
    color: #ffffff;
    font-weight: bold;
}

/* camera display */
QLabel#cameraDisplay {
    background-color: #000000;
    color: #aaaaaa;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    font-size: 14px;
}

/* objective, location labels */
QLabel#currentGoalLabel,
QLabel#etaLabel,
QLabel#xCoordLabel,
QLabel#yCoordLabel {
    padding: 5px;
    font-size: 11pt;
    color: #d4d4d4;
    background-color: #252526;
    border-radius: 4px;
    border: 1px solid #3e3e42;
    margin-bottom: 4px;
}

/* overrides frame */
QFrame#overridesFrame {
    background-color: #2d2d30;
    border: 1px solid #3e3e42;
    border-radius: 8px;
    padding: 15px;
}

/* overrides button */
QPushButton#manualOverridesButton {
    background-color: #D32F2F;
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 6px;
    font-weight: bold;
    font-size: 12pt;
}

QPushButton#manualOverridesButton:hover {
    background-color: #B71C1C;
}

QPushButton#manualOverridesButton:pressed {
    background-color: #9A0007;
}

/* dialog styles */
QDialog {
    background-color: #2d2d30;
    color: #ffffff;
}

QDialog QLabel {
    font-size: 11pt;
    color: #d4d4d4;
}

QDialog QPushButton {
    background-color: #007acc;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: bold;
}

QDialog QPushButton:hover {
    background-color: #118dff;
}

/* back button for main window */
QPushButton#backButton {
    background-color: #007acc;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: bold;
}

QPushButton#backButton:hover {
    background-color: #118dff;
}

QPushButton#backButton:pressed {
    background-color: #0056b3;
}

/* status section labels */
QLabel#batteryLabel,
QLabel#connectionLabel {
    font-weight: bold;
    font-size: 12pt;
}

/* camera section */
QLabel#cameraDisplay {
    text-align: center;
}

/* objectives section labels */
QLabel#currentGoalLabel,
QLabel#etaLabel {
    font-size: 11pt;
}

/* location section labels */
QLabel#xCoordLabel,
QLabel#yCoordLabel {
    font-size: 11pt;
}

/* overrides section button */
QPushButton#manualOverridesButton {
    font-weight: bold;
    font-size: 12pt;
}

/* splash screen elements */
QLabel#rover1Status,
QLabel#rover2Status,
QLabel#connectionStatus {
    font-weight: bold;
}

QLabel {
    color: #d4d4d4;
}
